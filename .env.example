# Copy this file to .env and paste your keys after the = sign (no quotes, no spaces).
# .env is listed in .gitignore, so your keys never reach GitHub.

# EIA: register at https://www.eia.gov/opendata/ (the key arrives by email)
EIA_API_KEY=

# FRED: sign in at https://fredaccount.stlouisfed.org, then request a key at
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
